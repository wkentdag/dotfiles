" Basics
syntax on
filetype plugin indent on
set nocompatible
set encoding=utf-8
set number
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set smartindent
set backspace=indent,eol,start

" True color (Ghostty / modern terminals) so the Cursor theme matches.
if has('termguicolors')
  set termguicolors
endif

" Match Cursor's Default Dark Modern.
set background=dark
colorscheme dark-modern
